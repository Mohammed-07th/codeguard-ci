# ---------------------------------------------------------------------------
# CodeGuard CI — environment template.
# Copy to .env and fill in real values. .env is gitignored and must stay so.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- LLM access (OpenRouter, OpenAI-compatible endpoint) -------------------
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Free-tier models verified for tool calling + structured output by
# scripts/qualify_models.py. Fallback fires on provider error / 429.
CODEGUARD_PRIMARY_MODEL=openai/gpt-oss-20b:free
CODEGUARD_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Specialist agent ReAct loops. Routed away from the small primary because
# gpt-oss-20b was measured to degenerate on long tool-using contexts.
CODEGUARD_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Larger model, used only for synthesis / cross-agent conflict resolution.
CODEGUARD_SYNTHESIS_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Bounds output length. Also prevents OpenRouter reserving the full context
# window against your credit balance (which returns HTTP 402 on a low balance).
CODEGUARD_MAX_OUTPUT_TOKENS=1024

# --- graph behaviour -------------------------------------------------------
CODEGUARD_MAX_ITER=3
CODEGUARD_MAX_REACT_STEPS=6
# Set to false ONLY for the guardrail-off A/B evidence cell. Never in production.
CODEGUARD_GUARDRAILS_ENABLED=true
# Hard cost ceiling per PR review, USD. Run aborts if exceeded.
CODEGUARD_COST_CAP_USD=0.50

# --- observability ---------------------------------------------------------
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
CODEGUARD_METRICS_PATH=evidence/metrics.jsonl

# --- artifact storage (MinIO, S3-compatible) -------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=codeguard
MINIO_ROOT_PASSWORD=codeguard123
MINIO_BUCKET=codeguard-reports
